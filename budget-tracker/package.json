    "oslo": "^1.2.1",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@node-rs/argon2": "^1.8.0",
    "motion": "^13.3.0",
    "lucide-react": "^1.56.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
